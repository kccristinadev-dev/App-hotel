<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.MainPage"
             Title="Hostly">

    <VerticalStackLayout Padding="30" Spacing="20">

        <Label Text="Bem-vindo ao Hostly!" FontSize="24" HorizontalOptions="Center" Style="{StaticResource TituloPrincipal}"  />
     
<Entry Placeholder="E-mail" /> 
         <Entry Placeholder="Senha"/>
            <Button Text="Entrar" Clicked="OnCounterClicked"   Style="{StaticResource BotaoPrimario}" />
  
    </VerticalStackLayout>
</ContentPage>

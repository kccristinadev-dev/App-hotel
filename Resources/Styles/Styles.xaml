<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- 🌅 CORES DO TEMA -->
    <Color x:Key="CorFundo">#FFF3E6</Color> <!-- bege claro -->
    <Color x:Key="CorPrimaria">#FF8A3D</Color> <!-- laranja -->
    <Color x:Key="CorTexto">#2B2B2B</Color> <!-- quase preto -->
    <Color x:Key="CorDestaque">#FFB37A</Color> <!-- laranja suave -->

    <!-- 📱 PÁGINA -->
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource CorFundo}" />
    </Style>

    <!-- TÍTULO -->
    <Style x:Key="TituloPrincipal" TargetType="Label">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="TextColor" Value="{StaticResource CorPrimaria}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <!-- TEXTO -->
    <Style x:Key="TextoPadrao" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{StaticResource CorTexto}"/>
    </Style>

    <!-- BOTÃO -->
    <Style x:Key="BotaoPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource CorPrimaria}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- FRAME -->
    <Style TargetType="Frame">
        <Setter Property="BackgroundColor" Value="White"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="HasShadow" Value="True"/>
        <Setter Property="Padding" Value="15"/>
    </Style>

</ResourceDictionary>

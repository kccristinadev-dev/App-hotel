<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
          x:Class="AppHotel.SobreHopedagem"
             Title="Hostly">

<VerticalStackLayout VerticalOptions = "CenterAndExpand">

<Label
Text = "Nome da suíte"/>


<Frame>
<HorizontalStackLayout>
<HorizontalStackLayout>
<Label
Text = "Adultos: "/>
<Label
Text = "Número de adultos "/>
</HorizontalStackLayout>

<HorizontalStackLayout>
<Label
Text = "Crianças: "/>
<Label
Text = "Número de crianças "/>
</HorizontalStackLayout>

</HorizontalStackLayout>

</Frame>

<Frame Margin = "10">
<Grid ColumnDefinitions = "*, *, *" RowDefinitions = "auto, auto">

<Label
 Grid.Row = "0" Grid.Column = "0" Text = "check-in: "/>
<Label
 Grid.Row = "0" Grid.Column = "1" Text = "check-out: "/>
<Label
 Grid.Row = "0" Grid.Column = "2" Text = "Estadia: "/>



<Label 
 Grid.Row = "1" Grid.Column = "0" Text = "Dia de início "/>
<Label
 Grid.Row = "1" Grid.Column = "1" Text = "data de término "/>

<Label
Grid.Row = "1" Grid.Column = "2" Text = "periodo em dias "/>
</Grid>
</Frame>

<Frame>
<Label
Text = "Valor total: "/>
<Label
Text = "Valor"/>
</Frame>

<Button Text = "" Clicked ="voltar_fazerhospedagem"/>
</VerticalStackLayout>

</ContentPage>
